         "elType": "widget",
         "settings": {
          "title": "סיפור של הצלחה",
          "header_size": "h2",
          "_css_classes": "nh-plain",
          "title_color": "#4A2D84",
          "__globals__": {
           "title_color": "globals/colors?id=primary",
