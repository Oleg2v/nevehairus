# Copy to .env and fill locally. NEVER commit .env (it is in .gitignore).
# Only the TEST site is allowed. The live site (nevehairus.com) is never written to.

WP_BASE_URL=https://nevehairus.ussl.co.il
WP_ADMIN_USER=
# WordPress Application Password (Users → Profile → Application Passwords). Revoke after use.
WP_APP_PASSWORD=

# Test recipient for form submissions (Oleg's address). Real recipients are configured in the widgets.
TEST_EMAIL_RECIPIENT=

# Optional: uPress panel access, only if Oleg grants it (read-only use; no changes without approval)
UPRESS_USER=
UPRESS_PASSWORD=
