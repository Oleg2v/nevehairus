         "settings": {
          "title": "מעון נווה האירוס, סיפור של הצלחה עבור דיירינו !",
          "header_size": "h2",
          "_css_classes": "nh-full",
          "title_color": "#4A2D84",
          "__globals__": {
           "title_color": "globals/colors?id=primary",
