         "settings": {
          "editor": "<p>ורבים ומכובדים נוספים אשר כיבדו אותנו בנוכחותם והקדישו מזמנם.</p><p>הרשימה הנה לפי סדר האלף -בית.</p>",
          "_css_classes": "nh-page__text nh-full",
