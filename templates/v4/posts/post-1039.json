        },
        {
         "id": "5b5aeaa",
         "elType": "widget",
         "settings": {
          "editor": "<p>בנווה האירוס מאמינים כי לכל אדם יש את המסוגלות שלו והיכולות השונות וכך גם עם אנשים בעלי מוגבלויות הגרים במעון. לחוסים בנווה האירוס ישנם חיים מלאים ומלאי פעילויות מקדמות, הצוות המקצועי, טיפולי יחד ובשיתוף ההנהלה, מקפידים על מגוון פעילויות רחב ומשתנה מדי תקופה, אך על מנת באמת, לקדם ולשפר את חייהם של החוסים בנווה האירוס, יש להעניק להם את תחושת השוויון, שהם אינם שונים מאיש, אנו דואגים לספק להם תעסוקה בשכר בצידה, שכן זו תורמת לביטחון עצמי, שייכות ומצב רוח חיובי וחיוני, מעצם העובדה כי קמים בבוקר, עובדים ומרוויחים כסף, הדימוי העצמי משתפר ותחושת המקובלות החברתית מתעצמת והדיירים חשים עצמם רצויים חברתית ומועילים לסביבה.</p><p>קרא עוד: <a href=\"@home:/מעון-ראשי-בית-לחיים/סנטוריום/\">סנטורים</a></p>",
          "_css_classes": "nh-page__text nh-full",
          "text_color": "#1F2421",
          "link_color": "#4A2D84",
          "link_hover_color": "#3A2269",
